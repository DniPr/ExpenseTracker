<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - ExpenseTracker
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar
                navbar-expand-lg
                navbar-light
                bg-white">

            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    ExpenseTracker
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item d-none"
                            id="dashboardNavItem">

                            <a class="nav-link"
                               asp-controller="Dashboard"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item d-none"
                            id="transactionsNavItem">

                            <a class="nav-link"
                               asp-controller="Transactions"
                               asp-action="Index">
                                Transactions
                            </a>
                        </li>

                        <li class="nav-item d-none"
                            id="categoriesNavItem">

                            <a class="nav-link"
                               asp-controller="Categories"
                               asp-action="Index">
                                Categories
                            </a>
                        </li>

                        <li class="nav-item d-none"
                            id="budgetsNavItem">

                            <a class="nav-link"
                               asp-controller="Budgets"
                               asp-action="Index">
                                Budgets
                            </a>
                        </li>

                        <li class="nav-item d-none"
                            id="recurringNavItem">

                            <a class="nav-link"
                               asp-controller="RecurringTransactions"
                               asp-action="Index">
                                Recurring
                            </a>
                        </li>

                        <li class="nav-item d-none"
                            id="goalsNavItem">

                            <a class="nav-link"
                               asp-controller="FinancialGoals"
                               asp-action="Index">
                                Goals
                            </a>
                        </li>

                    </ul>

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item"
                            id="loginNavItem">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item"
                            id="registerNavItem">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Register">
                                Register
                            </a>
                        </li>

                        <li class="nav-item d-none"
                            id="userNavItem">

                            <span class="nav-link">
                                Hello,
                                <strong id="currentUserName"></strong>
                            </span>
                        </li>

                        <li class="nav-item d-none"
                            id="logoutNavItem">

                            <button type="button"
                                    id="logoutButton"
                                    class="btn btn-link nav-link">
                                Logout
                            </button>
                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            &copy; @DateTime.Now.Year - ExpenseTracker
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/api.js"
            asp-append-version="true">
    </script>

    <script src="~/js/utils.js"
            asp-append-version="true">
    </script>

    <script src="~/js/auth.js"
            asp-append-version="true">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false)

</body>
</html>