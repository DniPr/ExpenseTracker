@{
    ViewData["Title"] = "Financial Goals";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Financial Goals</h1>
            <p class="text-muted mb-0">
                Track your savings targets and progress
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#createGoalModal">
            Add Goal
        </button>
    </div>

    <div id="goalsMessage"
         class="alert alert-danger d-none">
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div id="goalsContainer">
                <p class="text-muted mb-0">
                    Loading financial goals...
                </p>
            </div>

        </div>
    </div>
</div>

<div class="modal fade"
     id="createGoalModal"
     tabindex="-1"
     aria-labelledby="createGoalModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="createGoalModalLabel">
                    Add Financial Goal
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form id="createGoalForm">

                <div class="modal-body">

                    <div class="mb-3">
                        <label for="goalName"
                               class="form-label">
                            Name
                        </label>

                        <input type="text"
                               id="goalName"
                               class="form-control"
                               maxlength="150"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="goalDescription"
                               class="form-label">
                            Description
                        </label>

                        <textarea id="goalDescription"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="goalTargetAmount"
                               class="form-label">
                            Target Amount
                        </label>

                        <input type="number"
                               id="goalTargetAmount"
                               class="form-control"
                               min="0.01"
                               step="0.01"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="goalCurrentAmount"
                               class="form-label">
                            Current Amount
                        </label>

                        <input type="number"
                               id="goalCurrentAmount"
                               class="form-control"
                               min="0"
                               step="0.01"
                               value="0"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="goalTargetDate"
                               class="form-label">
                            Target Date
                        </label>

                        <input type="date"
                               id="goalTargetDate"
                               class="form-control" />

                        <div class="form-text">
                            Optional
                        </div>
                    </div>

                    <div id="createGoalMessage"
                         class="text-danger">
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Goal
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<div class="modal fade"
     id="editGoalModal"
     tabindex="-1"
     aria-labelledby="editGoalModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="editGoalModalLabel">
                    Edit Financial Goal
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form id="editGoalForm">

                <input type="hidden"
                       id="editGoalId" />

                <div class="modal-body">

                    <div class="mb-3">
                        <label for="editGoalName"
                               class="form-label">
                            Name
                        </label>

                        <input type="text"
                               id="editGoalName"
                               class="form-control"
                               maxlength="150"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="editGoalDescription"
                               class="form-label">
                            Description
                        </label>

                        <textarea id="editGoalDescription"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="editGoalTargetAmount"
                               class="form-label">
                            Target Amount
                        </label>

                        <input type="number"
                               id="editGoalTargetAmount"
                               class="form-control"
                               min="0.01"
                               step="0.01"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="editGoalCurrentAmount"
                               class="form-label">
                            Current Amount
                        </label>

                        <input type="number"
                               id="editGoalCurrentAmount"
                               class="form-control"
                               min="0"
                               step="0.01"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="editGoalTargetDate"
                               class="form-label">
                            Target Date
                        </label>

                        <input type="date"
                               id="editGoalTargetDate"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label for="editGoalStatus"
                               class="form-label">
                            Status
                        </label>

                        <select id="editGoalStatus"
                                class="form-select"
                                required>
                            <option value="1">
                                Active
                            </option>
                            <option value="2">
                                Completed
                            </option>
                            <option value="3">
                                Cancelled
                            </option>
                        </select>
                    </div>

                    <div id="editGoalMessage"
                         class="text-danger">
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/financial-goals.js"
            asp-append-version="true">
    </script>
}