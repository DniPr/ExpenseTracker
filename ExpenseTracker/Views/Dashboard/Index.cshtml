@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="mb-1">Dashboard</h1>
        <p class="text-muted mb-0">
            Overview of your finances
        </p>
    </div>

    <div id="dashboardError"
         class="alert alert-danger d-none">
    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        Current Balance
                    </div>

                    <div id="currentBalance"
                         class="fs-3 fw-bold">
                        -
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        Income This Month
                    </div>

                    <div id="incomeThisMonth"
                         class="fs-3 fw-bold text-success">
                        -
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        Expenses This Month
                    </div>

                    <div id="expensesThisMonth"
                         class="fs-3 fw-bold text-danger">
                        -
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        Savings This Month
                    </div>

                    <div id="savingsThisMonth"
                         class="fs-3 fw-bold">
                        -
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h4 class="mb-3">
                        Expenses by Category
                    </h4>

                    <div style="height: 320px;">
                        <canvas id="expensesByCategoryChart"></canvas>
                    </div>

                    <div id="expensesByCategoryEmpty"
                         class="text-muted text-center d-none mt-3">
                        No expense data for this month.
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h4 class="mb-3">
                        Income vs Expenses
                    </h4>

                    <div style="height: 320px;">
                        <canvas id="monthlySummaryChart"></canvas>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h4 class="mb-3">
                        Budget Progress
                    </h4>

                    <div id="budgetProgressContainer">
                        <p class="text-muted mb-0">
                            Loading...
                        </p>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h4 class="mb-3">
                        Recent Transactions
                    </h4>

                    <div id="recentTransactionsContainer">
                        <p class="text-muted mb-0">
                            Loading...
                        </p>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h4 class="mb-3">
                        Financial Goals
                    </h4>

                    <div id="activeGoalsContainer">
                        <p class="text-muted mb-0">
                            Loading...
                        </p>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h4 class="mb-3">
                        Upcoming Recurring Transactions
                    </h4>

                    <div id="upcomingRecurringContainer">
                        <p class="text-muted mb-0">
                            Loading...
                        </p>
                    </div>

                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="~/js/dashboard.js"
            asp-append-version="true">
    </script>
}